# Secrets and local config
.env
.env.*
!.env.example
# The master working file holds access tokens and client secrets - never commit it.
config/*.local.json
config/tokens/
*.pem

# Half-written files from an interrupted atomic save.
config/**/*.tmp

# Note: config/**/*.local.config IS committed on purpose. Those files hold looks,
# commands and timer settings - no credentials - so they travel between machines.

# Node
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.cache/

# Native plugin builds
plugins/**/build/
CMakeCache.txt
CMakeFiles/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Runtime artifacts
logs/
*.log
recordings/
clips/
