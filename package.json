{
  "name": "obs-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first multi-platform streaming toolkit for OBS (Twitch, YouTube, Kick)",
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#core/*": "./packages/core/src/*"
  },
  "dependencies": {},
  "scripts": {
    "start": "node packages/bridge/bin/start.js",
    "demo": "node packages/bridge/bin/start.js --demo",
    "test": "node --test packages/**/test/*.test.js",
    "diagnose": "node packages/bridge/bin/diagnose.js"
  }
}
